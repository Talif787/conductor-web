# conductor-web production environment (set these in the Vercel dashboard,
# scoped to Production; use a separate value in the Preview scope).
#
# Origin of the deployed control-api. The Next rewrite proxies /api/v1/* here.
# Point Production at the Render backend URL, e.g. https://conductor-api.onrender.com
CONDUCTOR_API_ORIGIN=<RENDER_BACKEND_URL>

# The active locale is chosen at runtime from the NEXT_LOCALE cookie (default
# English); no build-time locale variable is required.
